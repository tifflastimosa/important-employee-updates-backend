spring.application.name=important-messages-prototype

# Copy this file to application.properties (which is git-ignored) and fill in your credentials.
# Get the connection string from MongoDB Atlas: Database -> Connect -> Drivers.
spring.mongodb.uri=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
spring.mongodb.database=important_messages

# Origins allowed to call the API from a browser (comma-separated). On Heroku, set the
# APP_CORS_ALLOWED_ORIGINS config var to your deployed frontend's URL instead.
app.cors.allowed-origins=http://localhost:5173
